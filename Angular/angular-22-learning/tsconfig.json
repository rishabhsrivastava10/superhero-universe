/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      // Mapped to library SOURCE, not dist/. The libraries are consumed only by this workspace,
      // so compiling against source removes the "rebuild the library before the app sees your
      // change" step. Switch these to ./dist/* if a library is ever published to a registry.
      "common-ui": ["./libs/common-ui/src/public-api.ts"],
      "superhero-universe": ["./libs/superhero-universe/src/public-api.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./libs/common-ui/tsconfig.lib.json"
    },
    {
      "path": "./libs/common-ui/tsconfig.spec.json"
    },
    {
      "path": "./libs/superhero-universe/tsconfig.lib.json"
    },
    {
      "path": "./libs/superhero-universe/tsconfig.spec.json"
    }
  ]
}
